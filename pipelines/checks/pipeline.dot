// checks — run the repo's deterministic checks and exit. No LLM nodes, no
// gates: the implement pipeline's static-check chain (deps → typecheck →
// lint → test) lifted out on its own, for proving a repo's configured
// checks pass in a given execution environment (e.g. a VM runner) without
// involving an agent.
//
// Commands come from the repo's checks config, seeded into the run context
// as -var check.<name>=… on the CLI (a no-op echo when unconfigured).
// A failing check has no fail edge and no agent to route back to, so the
// run fails with that check's output — which is the diagnostic signal this
// pipeline exists to produce.
//
//   POST /workflows/checks/run {"repo":"TryGhost/Ghost"}
digraph checks {
    // D1: transient backend failures (429/5xx, stalls, network) retry
    // with backoff instead of killing the run.
    default_max_retries = 2
    goal = "Run the deterministic checks for $context.repo"
    vars = "repo"
    max_node_visits = 1

    start [shape=Mdiamond]

    // The shared checks-core chain (deps → typecheck → lint → test). It
    // early-exits and reports outcome=fail on the first failing check; the
    // unconditional `gate -> done` then has no eligible edge for a failure,
    // so the run fails with that check's output — the signal this pipeline
    // exists to produce.
    gate [type="subgraph", graph_ref="../checks-core/pipeline.dot"]

    done [shape=Msquare]

    start -> gate
    gate -> done
}
