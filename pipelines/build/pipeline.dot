// build — the milestone-build pipeline. Implements the next `todo`
// milestone from the spec passed as --var spec=<path>, one per run,
// gated by tests then the shared multi-lens review-core fanout (five
// adversarial lenses + a synth verdict), looping implement/fix against
// review until the verdict passes (no blocking comments left).
//
//   BASE=$(jj log -r @- --no-graph -T change_id | tr -d '[:space:]')
//   attractor run --backend acp \
//     --var spec=docs/<spec>.md --var review_base=$BASE \
//     --logs ~/.attractor/runs/<milestone> pipelines/build/pipeline.dot
//
// review_base is the change id of the commit BEFORE this run's first
// milestone commit; the review lenses diff `--from $review_base --to @`
// so they see exactly this milestone's change. Advance it between runs.
//
// Loop shape:
//   plan -> plan_gate (human) -> implement -> verify -> review_loop
//   verify   fail -> implement        (test/gate failures, same thread)
//   review_loop success -> record     (synth PASS: no blocking findings)
//   review_loop fail    -> fix        (synth FAIL: blocking findings)
//   fix -> verify -> review_loop ...  (re-review after every fix)
//
// The fix node reads the synth's blocking findings from
// $context.failure_reason and the change itself from
// `jj diff --from $context.review_base --to @`.

digraph build {
    // D1: transient backend failures (429/5xx, stalls, network) retry
    // with backoff instead of killing the run.
    default_max_retries = 2
    goal = "Implement the next todo milestone from $context.spec"
    cwd = "/home/agent/attractor"
    vars = "spec,review_base"
    max_node_visits = 10

    start [shape=Mdiamond]

    plan [type="codergen.acp", llm_model="claude-fable-5[1m]",
          thread_id="build", fidelity="full",
          timeout="20m", prompt="@prompts/plan.md"]

    // Human check-in on the plan before any code gets written. Console
    // when run from a TTY; auto-approved in non-interactive runs.
    plan_gate [shape=hexagon, label="Does the plan make sense?"]

    implement [type="codergen.acp", llm_model="claude-fable-5[1m]",
               thread_id="build", fidelity="full",
               timeout="120m", goal_gate=true, retry_target="plan",
               prompt="@prompts/implement.md"]

    // Gate: race tests + gofmt + no-conflicts. `nix build` omitted to keep
    // memory pressure down; dep-changing milestones run it in-stage.
    verify [type="tool", timeout="20m",
            tool_command="cd /home/agent/attractor && nix develop -c go test ./... -race -count=1 && test -z \"$(nix develop -c gofmt -l . 2>/dev/null)\" && test -z \"$(jj resolve --list 2>/dev/null)\""]

    // Multi-lens review of this milestone's change, inlined at load
    // time (D6): synth's PASS/FAIL verdict drives the outcome edges.
    review_loop [type="subgraph",
                 graph_ref="../review-core/pipeline.dot",
                 var.diff_cmd="jj diff --from $context.review_base --to @"]

    // Reached only after a FAIL verdict, so the child's findings are set.
    fix [type="codergen.acp", thread_id="build", fidelity="full",
         timeout="120m", prompt="@prompts/fix.md"]

    record [type="codergen.acp", thread_id="build", fidelity="full",
            timeout="15m", prompt="@prompts/record.md"]

    done [shape=Msquare]

    start -> plan
    plan -> plan_gate
    plan_gate -> implement [label="[A] Approve plan"]
    plan_gate -> plan      [label="[R] Revise plan"]
    implement -> verify      [condition="outcome=success"]
    implement -> plan        [condition="outcome=fail", label="Replan"]
    verify -> review_loop     [condition="outcome=success"]
    verify -> implement       [condition="outcome=fail", label="Fix gate"]
    review_loop -> record     [condition="outcome=success", label="Verdict PASS"]
    review_loop -> fix        [condition="outcome=fail", label="Verdict FAIL"]
    fix -> verify             [condition="outcome=success"]
    fix -> plan               [condition="outcome=fail", label="Replan"]
    record -> done
}
