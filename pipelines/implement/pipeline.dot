// implement — build the change an Issue asks for: plan (human-gated),
// implement in small jj commits, deterministic static checks, an
// adversarial self-review, a human ship gate, then a draft PR.
//
// The router's `issue` target: stack.manager_loop runs this child inline
// and sources its declared vars from context (router-spec R3). It also runs
// standalone from the CLI against the same contract:
//
//   attractor run implement -var repo=owner/name -var identifier=ENG-42 \
//     -var url=… -var title=…
//
// Flow: a `baseline_*` chain runs the repo's deterministic checks FIRST,
// proving the starting point is green — a baseline failure fails the run
// (there is no agent yet to route to, and implementing on a broken base
// makes every later check failure ambiguous: ours or pre-existing?).
// `plan` then reads the issue and produces a plan — no code — and
// self-reports `review_base` (the change id before any work) via its
// status.json context_updates. A human approves the plan at `plan_gate`
// (browser /questions surface under the daemon, console from a TTY).
// `implement` then works in small atomic jj commits; four deterministic
// tool nodes run the repo's configured checks (seeded as
// $context.check.<name> by the daemon; a no-op when unconfigured), each
// routing back to `implement` on failure. `review_loop` runs the shared
// review-core sub-pipeline against everything since review_base —
// committed work plus any stray working-copy changes. A PASS reaches the
// human ship gate; shipping opens a draft PR on the repo's GitHub remote.
digraph implement {
    // D1: transient backend failures (429/5xx, stalls, network) retry
    // with backoff instead of killing the run.
    default_max_retries = 2
    goal = "Implement issue $context.identifier — \"$context.title\" — in $context.repo"
    vars = "repo,identifier,url,title,body"
    max_node_visits = 10

    start [shape=Mdiamond]

    // Baseline: the same deterministic checks as the post-implement gate,
    // run BEFORE any work. Distinct nodes (not the gating ones below) so a
    // baseline failure terminates the run with the check's output instead
    // of routing to `implement`, and so gate-node visit counts stay clean.
    baseline_deps      [type="tool", timeout="20m", tool_command="$context.check.deps"]
    baseline_typecheck [type="tool", timeout="20m", tool_command="$context.check.typecheck"]
    baseline_lint      [type="tool", timeout="20m", tool_command="$context.check.lint"]
    baseline_test      [type="tool", timeout="40m", tool_command="$context.check.test"]

    // Each codergen stage gets its OWN thread: sharing one thread meant
    // implement resumed plan's session and replayed its full transcript,
    // which Fable 5's safeguards false-positive flagged as reverse
    // engineering and refused (2026-08-12, run 4f0a9ed2). The plan travels
    // as context (plan_markdown from plan's status.json), not as session
    // history.
    // outputs= documents the keys the plan agent sets via its status.json
    // context_updates, for the context_refs lint and human readers.
    plan [llm_model="claude-fable-5[1m]", thread_id="plan",
          fidelity="full", timeout="30m", prompt="@prompts/plan.md",
          outputs="plan_markdown,review_base"]

    // Human check-in on the plan before any code gets written.
    plan_gate [shape=hexagon, label="Does the plan make sense?"]

    implement [llm_model="claude-fable-5[1m]", thread_id="build",
               fidelity="full", timeout="120m",
               prompt="@prompts/implement.md"]

    // Deterministic checks — commands come from the repo's checks config,
    // seeded into context by the daemon. They run in the run's cwd (the repo).
    deps      [type="tool", timeout="20m", tool_command="$context.check.deps"]
    typecheck [type="tool", timeout="20m", tool_command="$context.check.typecheck"]
    lint      [type="tool", timeout="20m", tool_command="$context.check.lint"]
    test      [type="tool", timeout="40m", tool_command="$context.check.test"]

    // Adversarial self-review of everything since the plan's review_base
    // (implement commits as it goes, so a plain `jj diff` would miss the
    // committed work).
    review_loop [type="stack.manager_loop", timeout="45m",
                 stack.child_dotfile="../review-core/pipeline.dot",
                 stack.child.var.diff_cmd="jj diff --from $context.review_base --to @"]

    ship [shape=hexagon, label="Ship these changes? (checks + self-review passed)"]

    // Publish: push the committed work and open a draft PR for human review.
    open_pr [llm_model="claude-fable-5[1m]", thread_id="publish",
             fidelity="full", timeout="15m", prompt="@prompts/open-pr.md"]

    done [shape=Msquare]

    start -> baseline_deps
    baseline_deps      -> baseline_typecheck
    baseline_typecheck -> baseline_lint
    baseline_lint      -> baseline_test
    baseline_test      -> plan
    plan -> plan_gate
    plan_gate -> implement [label="[A] Approve plan"]
    plan_gate -> plan      [label="[R] Revise plan"]
    implement -> deps
    deps      -> typecheck   [condition="outcome=success"]
    deps      -> implement   [condition="outcome=fail", label="Fix deps"]
    typecheck -> lint        [condition="outcome=success"]
    typecheck -> implement   [condition="outcome=fail", label="Fix types"]
    lint      -> test        [condition="outcome=success"]
    lint      -> implement   [condition="outcome=fail", label="Fix lint"]
    test      -> review_loop  [condition="outcome=success"]
    test      -> implement    [condition="outcome=fail", label="Fix tests"]
    review_loop -> ship       [condition="outcome=success"]
    review_loop -> implement  [condition="outcome=fail", label="Address findings"]
    ship -> open_pr   [label="[S] Ship"]
    ship -> implement [label="[C] Request changes"]
    open_pr -> done
}
