// implement — build the change an Issue asks for (router-spec R6).
//
// The router's `issue` target: stack.manager_loop runs this child inline
// and sources its declared vars from context (router-spec R3). It also
// runs standalone from the CLI against the same prepare-time contract:
//
//   attractor run implement -var repo=owner/name -var identifier=ENG-42 \
//     -var url=… -var title=…
//
// These are exactly the vars a Linear issue Item supplies
// (internal/source/linear.go), plus `repo` from the run request.
digraph implement {
    goal = "Implement issue $identifier — \"$title\" — in $repo"
    vars = "repo,identifier,url,title"
    max_node_visits = 3

    start [shape=Mdiamond]

    implement [timeout="120m", prompt="@prompts/implement.md"]

    done [shape=Msquare]

    start -> implement
    implement -> done
}
