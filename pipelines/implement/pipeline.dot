// implement — build the change an Issue asks for, gated by static checks,
// then an adversarial self-review, then a human ship gate. Merges the old
// `task` pipeline's deterministic check backbone (deps/typecheck/lint/test)
// into the item-driven implement flow.
//
// The router's `issue` target: stack.manager_loop runs this child inline
// and sources its declared vars from context (router-spec R3). It also runs
// standalone from the CLI against the same contract:
//
//   attractor run implement -var repo=owner/name -var identifier=ENG-42 \
//     -var url=… -var title=…
//
// Flow: the agent implements, then four deterministic tool nodes run the
// repo's configured checks (seeded as $context.check.<name> from the repo's
// .attractor/config.toml [checks] table; a no-op when unconfigured). Each
// check routes back to `implement` on failure so the agent fixes it. Once
// the checks pass, `review_loop` runs the shared review-core sub-pipeline
// (five adversarial lenses + synth) against the agent's uncommitted diff; a
// FAIL routes back to implement. A PASS reaches the human ship gate.
digraph implement {
    goal = "Implement issue $context.identifier — \"$context.title\" — in $context.repo"
    vars = "repo,identifier,url,title"
    max_node_visits = 6

    start [shape=Mdiamond]

    implement [timeout="120m", prompt="@prompts/implement.md"]

    // Deterministic checks — commands come from the repo's [checks] config,
    // seeded into context by the daemon. They run in the run's cwd (the repo).
    deps      [type="tool", timeout="20m", tool_command="$context.check.deps"]
    typecheck [type="tool", timeout="20m", tool_command="$context.check.typecheck"]
    lint      [type="tool", timeout="20m", tool_command="$context.check.lint"]
    test      [type="tool", timeout="40m", tool_command="$context.check.test"]

    // Adversarial self-review of the uncommitted change (review-core).
    review_loop [type="stack.manager_loop", timeout="45m",
                 stack.child_dotfile="../review-core/pipeline.dot",
                 stack.child.var.diff_cmd="jj diff"]

    ship [shape=hexagon, label="Ship these changes? (checks + self-review passed)"]

    done [shape=Msquare]

    start -> implement -> deps
    deps      -> typecheck   [condition="outcome=success"]
    deps      -> implement   [condition="outcome=fail", label="Fix deps"]
    typecheck -> lint        [condition="outcome=success"]
    typecheck -> implement   [condition="outcome=fail", label="Fix types"]
    lint      -> test        [condition="outcome=success"]
    lint      -> implement   [condition="outcome=fail", label="Fix lint"]
    test      -> review_loop  [condition="outcome=success"]
    test      -> implement    [condition="outcome=fail", label="Fix tests"]
    review_loop -> ship       [condition="outcome=success"]
    review_loop -> implement  [condition="outcome=fail", label="Address findings"]
    ship -> done      [label="[S] Ship"]
    ship -> implement [label="[C] Request changes"]
}
