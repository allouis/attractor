// router — route an Item to the right work pipeline (router-spec R6).
//
// Run through the single admission point, exactly like any pipeline:
//
//   POST /items/run {item_ref, pipeline: ".../router/pipeline.dot", repo}
//
// The daemon resolves the Item to vars and SEEDS them — plus the
// Ref-derived item.type/item.source/item.id — into the run's initial
// context (router-spec R2). `classify` branches on that seeded `item.type`.
//
// A PR is always a review (deterministic → review-pr). An issue could be a
// feature or a bug, so it goes to the `triage` agent, which reads it and
// emits `decision` ∈ {implement, bugfix, design}. An unknown type triages
// against the full set. Route targets are a CLOSED set — one
// stack.manager_loop per work pipeline, each running its child inline and
// sourcing the child's vars from context (router-spec R1/R3).
//
// child_dotfile paths are authored relative to this pipeline's directory.
digraph router {
    // D1: transient backend failures (429/5xx, stalls, network) retry
    // with backoff instead of killing the run.
    default_max_retries = 2
    goal = "Route the item to the right work pipeline"
    max_node_visits = 2

    start [shape=Mdiamond]

    classify [type="conditional"]

    review_pr_loop [type="stack.manager_loop", stack.child_dotfile="../review-pr/pipeline.dot"]
    implement_loop [type="stack.manager_loop", stack.child_dotfile="../implement/pipeline.dot"]
    bugfix_loop    [type="stack.manager_loop", stack.child_dotfile="../bug-fix/pipeline.dot"]

    // Agent that reads an issue and picks the work pipeline for it.
    triage [prompt="@prompts/triage.md"]

    // Undecidable item → surface to a human (a deterministic tool node).
    needs_design [type="tool",
                  tool_command="echo 'router: item needs a human design decision' >&2"]

    done [shape=Msquare]

    start -> classify

    classify -> review_pr_loop [condition="item.type=pr"]
    classify -> triage         [condition="item.type=issue"]
    classify -> triage         [condition="item.type=unknown"]

    triage -> review_pr_loop [condition="decision=review"]
    triage -> implement_loop [condition="decision=implement"]
    triage -> bugfix_loop    [condition="decision=bugfix"]
    triage -> needs_design   [condition="decision=design"]

    review_pr_loop -> done
    implement_loop -> done
    bugfix_loop    -> done
    needs_design   -> done
}
