// bug-fix — reproduce and fix the bug an Issue reports, gated by static
// checks then an adversarial self-review, then a human ship gate. The
// modern, item-driven successor to the old bug-fix pipeline: same item var
// contract as `implement` (so the router can dispatch it), a reproduce
// step, and the shared review-core review instead of a bespoke fan-out.
//
//   attractor run bug-fix -var repo=owner/name -var identifier=BUG-12 \
//     -var url=… -var title=…
//
// understand → reproduce (goal-gated: a failing test that pins the bug) →
// fix (goal-gated: the test passes) → the same deterministic checks and
// review-core loop as implement. Failing checks / findings route back to
// `fix`.
digraph bug_fix {
    goal = "Reproduce and fix the bug in $context.identifier — \"$context.title\" — in $context.repo"
    vars = "repo,identifier,url,title"
    max_node_visits = 6

    start [shape=Mdiamond]

    understand [timeout="30m", prompt="@prompts/understand.md"]
    reproduce  [timeout="60m", prompt="@prompts/reproduce.md", goal_gate=true]
    fix        [timeout="120m", prompt="@prompts/fix.md", goal_gate=true]

    deps      [type="tool", timeout="20m", tool_command="$context.check.deps"]
    typecheck [type="tool", timeout="20m", tool_command="$context.check.typecheck"]
    lint      [type="tool", timeout="20m", tool_command="$context.check.lint"]
    test      [type="tool", timeout="40m", tool_command="$context.check.test"]

    review_loop [type="stack.manager_loop", timeout="45m",
                 stack.child_dotfile="../review-core/pipeline.dot",
                 stack.child.var.diff_cmd="jj diff"]

    ship [shape=hexagon, label="Ship this fix? (repro + checks + self-review passed)"]

    done [shape=Msquare]

    start -> understand -> reproduce -> fix -> deps
    deps      -> typecheck   [condition="outcome=success"]
    deps      -> fix         [condition="outcome=fail", label="Fix deps"]
    typecheck -> lint        [condition="outcome=success"]
    typecheck -> fix         [condition="outcome=fail", label="Fix types"]
    lint      -> test        [condition="outcome=success"]
    lint      -> fix         [condition="outcome=fail", label="Fix lint"]
    test      -> review_loop  [condition="outcome=success"]
    test      -> fix          [condition="outcome=fail", label="Fix tests"]
    review_loop -> ship       [condition="outcome=success"]
    review_loop -> fix        [condition="outcome=fail", label="Address findings"]
    ship -> done [label="[S] Ship"]
    ship -> fix  [label="[C] Request changes"]
}
