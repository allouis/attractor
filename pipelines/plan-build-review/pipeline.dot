// plan-build-review — build the change a brief asks for: plan (human-gated),
// implement in small jj commits, deterministic static checks, an
// adversarial self-review, a human ship gate, then a draft PR.
//
// The task is a single freeform `brief` — the orchestrator assembles it
// however it likes (an issue's title+body+url, a spec milestone, or a plain
// paragraph). The pipeline is source-agnostic; it just builds what the
// brief describes.
//
// Runs standalone from the CLI against this var contract:
//
//   attractor run plan-build-review --stylesheet pipelines/models.css \
//     -var brief="…the change to make…" -var base=main \
//     -var check.deps=… -var check.typecheck=… \
//     -var check.lint=… -var check.test=…
//
// The review base is deterministic: `base` is the target branch (the PR
// base). `set_base` runs `jj new $context.base@origin` up front, so the
// working copy sits on a fresh empty change atop a KNOWN revision — no
// agent has to capture "whatever @ happened to be". Everything downstream
// (the review diff, the PR base) references `$context.base@origin`.
//
// Flow: `set_base` positions the working copy on the base. A `baseline_*`
// chain then runs the repo's deterministic checks on that base — proving
// the starting point is green before any work (a baseline failure fails
// the run: there is no agent yet to route to, and implementing on a
// broken base makes every later check failure ambiguous: ours or
// pre-existing?). `plan` reads the issue and produces a plan — no code. A
// human approves the plan at `plan_gate` (the run's own /questions surface
// under --ui, console from a TTY); a revise request routes to `revise_plan`
// (which carries the human's note back into plan's session) and re-gates.
// `implement` then works in small atomic
// jj commits; four deterministic tool nodes run the repo's configured
// checks (seeded as -var check.<name>=… on the CLI), each routing back to
// `implement` on failure. `review_loop` runs the shared review-core
// sub-pipeline against everything since `base` — committed work plus any
// stray working-copy changes. A PASS reaches the human ship gate; shipping
// opens a draft PR (base = $context.base) on the repo's GitHub remote.
digraph plan_build_review {
    // D1: transient backend failures (429/5xx, stalls, network) retry
    // with backoff instead of killing the run.
    default_max_retries = 2
    goal = ""
    vars = "brief,base"
    max_node_visits = 10

    start [shape=Mdiamond]

    // Pin the review base deterministically: move the working copy onto a
    // fresh empty change atop $context.base@origin (the target branch's
    // remote tip). Everything downstream diffs from this same revision, so
    // no agent has to capture it. Runs FIRST, before baseline, so the
    // baseline checks validate the exact base we build on.
    set_base [type="tool", timeout="5m",
              tool_command="jj new $context.base@origin"]

    // Baseline: the repo's deterministic checks (checks-core) run BEFORE
    // any work. A separate instance from the post-implement gate below, and
    // wired to terminate on failure — `baseline -> plan` is unconditional,
    // so an outcome=fail has no eligible edge and the run stops with the
    // check's output, instead of routing to a fixer with no work to fix.
    baseline [type="subgraph", graph_ref="../checks-core/pipeline.dot"]

    // The two ROLES — plan and build — each get their own thread; the
    // stages WITHIN a role share it. Cross-role sharing meant implement
    // resumed plan's session and replayed its full transcript, which Fable
    // 5's safeguards false-positive flagged as reverse engineering and
    // refused (2026-08-12, run 4f0a9ed2). So the plan travels to build as
    // context (plan_markdown from plan's status.json), not as session
    // history. Within a role, sharing the thread is the point: revise_plan
    // continues plan's own session, and the build-side responders continue
    // implement's.
    // outputs= documents the keys the plan agent sets via its status.json
    // context_updates, for the context_refs lint and human readers.
    plan [class="plan", thread_id="plan",
          fidelity="full", timeout="30m", prompt="@prompts/plan.md",
          outputs="plan_markdown"]

    // Dedicated plan-revise responder: shares plan's thread so the resumed
    // session still holds the plan just written, and carries ONLY the
    // human's rejection note ($context.human.note) — mirroring the
    // build-side responders. Re-emits plan_markdown for a fresh plan_gate.
    revise_plan [class="plan, revise", thread_id="plan",
                 fidelity="full", timeout="30m",
                 prompt="@prompts/revise-plan.md",
                 outputs="plan_markdown"]

    // Human check-in on the plan before any code gets written.
    plan_gate [shape=hexagon, label="Does the plan make sense?"]

    implement [class="build, coder", thread_id="build",
               fidelity="full", timeout="120m",
               prompt="@prompts/implement.md"]

    // Failure responders. Both share implement's thread (fidelity=full),
    // so the resumed agent session already holds the issue, the plan,
    // and everything it did — each visit sends ONLY the small prompt
    // plus the failure at hand. Routing failures back to `implement`
    // re-sent its full prompt (issue body and all) into the same
    // session on every loop iteration (run ghost-hkg-1914, 2026-08-15).
    fix_checks [class="build, fixer", thread_id="build",
                fidelity="full", timeout="60m",
                prompt="@prompts/fix-checks.md"]

    respond_to_review [class="build, responder", thread_id="build",
                       fidelity="full", timeout="60m",
                       prompt="@prompts/respond-review.md"]

    // Post-implement gate: the same checks-core sub-pipeline, but here a
    // failure routes to the fix_checks responder (see edges). The failing
    // check's output reaches the fixer via $context.tool.output.
    checks [type="subgraph", graph_ref="../checks-core/pipeline.dot"]

    // Adversarial self-review of everything since the base
    // (implement commits as it goes, so a plain `jj diff` would miss the
    // committed work).
    // Inlined at load time (D6): synth's verdict drives the outcome
    // edges below directly.
    review_loop [type="subgraph",
                 graph_ref="../review-core/pipeline.dot",
                 var.diff_cmd="jj diff --from $context.base@origin --to @"]

    ship [shape=hexagon, label="Ship these changes? (checks + self-review passed)"]

    // Publish: push the committed work and open a draft PR for human review.
    open_pr [class="publish", thread_id="publish",
             fidelity="full", timeout="15m", prompt="@prompts/open-pr.md"]

    done [shape=Msquare]

    start -> set_base
    set_base -> baseline
    baseline -> plan            // fail is unrouted → terminates the run
    plan -> plan_gate
    plan_gate   -> implement   [label="[A] Approve plan"]
    plan_gate   -> revise_plan [label="[R] Revise plan"]
    revise_plan -> plan_gate
    implement         -> checks
    fix_checks        -> checks
    respond_to_review -> checks
    checks -> review_loop        [condition="outcome=success"]
    checks -> fix_checks         [condition="outcome=fail", label="Fix checks"]
    review_loop -> ship              [condition="outcome=success"]
    review_loop -> respond_to_review [condition="outcome=fail", label="Address findings"]
    ship -> open_pr           [label="[S] Ship"]
    ship -> respond_to_review [label="[C] Request changes"]
    open_pr -> done
}
