// review-core — the shared multi-lens review sub-pipeline
// (review-pipeline-spec RV2).
//
// Five adversarial reviewers run in parallel, each from a different lens,
// then `synth` merges their findings into one review plus a PASS/FAIL
// verdict. Reused by the PR-review and implement pipelines via
// stack.manager_loop, seeding `diff_cmd` through the child context.
//
// The one input is `diff_cmd`: the command that shows the change under
// review. Each lens runs it to see the diff; different callers pass
// different diffs. Standalone:
//
//   attractor run review-core -var diff_cmd="jj diff"
//
// Findings ride context, not files: each lens sets output_key=review.<lens>
// so its full response is captured into its outcome's context_updates, which
// `parallel` bundles into parallel.results. `synth` interpolates
// $context.parallel.results, so nothing is written into the repo cwd and the
// diff under review stays clean.
digraph review_core {
    goal = "Multi-lens review of the change shown by $context.diff_cmd"
    vars = "diff_cmd"
    max_node_visits = 2

    start [shape=Mdiamond]

    // Fan out to every lens concurrently. The branches converge on `synth`
    // (their only common downstream), so the parallel handler routes there
    // directly — no fan_in, which would only pick a single winner.
    fan_out [shape=component]

    correctness    [output_key="review.correctness", timeout="30m", prompt="Run `$context.diff_cmd` to see the change under review. This code is broken. Find the bugs — edge cases, error paths, races. Review adversarially and list every concrete defect you can find."]
    design         [output_key="review.design", timeout="30m", prompt="Run `$context.diff_cmd` to see the change under review. Review from a clean-code perspective; focus on the coupling and cohesion of the modules. Call out every design smell."]
    prod_safety    [output_key="review.prod_safety", timeout="30m", prompt="Run `$context.diff_cmd` to see the change under review. Why should we *not* merge this to production? How does it break? Review adversarially and list every blocking risk."]
    simplification [output_key="review.simplification", timeout="30m", prompt="Run `$context.diff_cmd` to see the change under review. How can we simplify this and make it less complected? List every concrete simplification."]
    tests          [output_key="review.tests", timeout="30m", prompt="Run `$context.diff_cmd` to see the change under review. Do the tests still pass if we refactor the implementation? Are they coupled to implementation detail? List every test that is over-coupled or missing."]

    // Convergence node: merges the five findings and self-reports the
    // verdict via the status-file contract (spec §4.5). Its outcome IS
    // review-core's terminal outcome, so a parent can branch on it.
    synth [timeout="15m", prompt="Five reviewers each reviewed the same change through a different lens. Their findings are in $context.parallel.results (JSON — each branch's context_updates holds one review.<lens> entry). Merge them into a single review, deduping overlapping points. Then self-report the verdict via your status.json: outcome SUCCESS with context_updates {review.summary, review.verdict=pass} when nothing blocks a merge, otherwise outcome FAIL with the blocking issues in failure_reason and context_updates {review.verdict=fail}."]

    done [shape=Msquare]

    start -> fan_out

    fan_out -> correctness
    fan_out -> design
    fan_out -> prod_safety
    fan_out -> simplification
    fan_out -> tests

    correctness    -> synth
    design         -> synth
    prod_safety    -> synth
    simplification -> synth
    tests          -> synth

    synth -> done
}
