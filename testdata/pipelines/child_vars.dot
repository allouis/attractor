// Child pipeline that declares a var and expands it into a prompt, so a
// test can observe the value manager_loop sourced from context (R3).
digraph child_vars {
    vars = "x"
    goal = "child with vars"
    start    [shape=Mdiamond]
    childwork [shape=box, prompt="value=$x"]
    done     [shape=Msquare]
    start -> childwork -> done
}
