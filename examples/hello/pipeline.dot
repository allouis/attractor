// hello — minimal Attractor pipeline.
// Run: `attractor run hello --var name=world`
digraph hello {
    graph [
        goal="say hi to $context.name",
        vars="name"
    ]

    start [shape=Mdiamond]
    greet [prompt="@prompts/greet.md"]
    done  [shape=Msquare]

    start -> greet -> done
}
